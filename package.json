{
  "name": "git-repository-forensics",
  "version": "1.0.0",
  "private": true,
  "description": "Database-driven platform for Git history analysis, change-coupling detection and developer activity intelligence (DBMS Level 3 project).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "worker": "tsx workers/analysis-worker.ts",
    "db:up": "docker compose --env-file .env.local up -d",
    "db:down": "docker compose --env-file .env.local down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-dev-db.ts",
    "neo4j:init": "tsx scripts/neo4j-init.ts",
    "fixture": "tsx scripts/create-fixture-repo.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "ioredis": "5.8.2",
    "neo4j-driver": "5.28.3",
    "next": "15.5.28",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "2.15.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
