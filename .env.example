# Copy to .env.local and replace every CHANGE_ME value.
# .env.local is git-ignored; never commit real credentials.

# ---------- PostgreSQL (authoritative store) ----------
POSTGRES_USER=grf
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=grf
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://grf:CHANGE_ME@localhost:5433/grf
# Separate disposable database used by the integration tests (created by `npm run db:reset -- --test`)
TEST_DATABASE_URL=postgres://grf:CHANGE_ME@localhost:5433/grf_test

# ---------- Neo4j (graph projection) ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_min8chars
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---------- Redis (cache, job progress, rate limiting) ----------
REDIS_URL=redis://:CHANGE_ME@localhost:6380/0
REDIS_PASSWORD=CHANGE_ME
REDIS_HOST_PORT=6380

# ---------- Application ----------
# Initial administrator created by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_long_password
# Set to "false" to disable public self-registration of analyst accounts
ALLOW_SELF_REGISTRATION=true
# Session lifetime in hours
SESSION_TTL_HOURS=12

# ---------- Repository analysis ----------
# Only https:// URLs whose host is on this list may be cloned (SSRF protection)
ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org,codeberg.org
# Directory (absolute or relative to project root) whose sub-directories may be
# registered as "local" repositories. Nothing outside it is ever readable.
LOCAL_REPO_ROOT=./fixtures/repos
# Where the worker keeps bare clones
WORKSPACE_DIR=./.workspaces
# Commits that touch more than this many files are excluded from co-change statistics
COUPLING_MAX_FILES_PER_COMMIT=30
# Minimum shared commits for a pair to be stored as a coupling edge
COUPLING_MIN_COCHANGE=2
# Safety caps
ANALYSIS_MAX_COMMITS=50000
GIT_CLONE_TIMEOUT_MS=600000
BLAME_MAX_FILES=150
HUNK_MAX_COMMITS=3000
WORKER_POLL_INTERVAL_MS=3000
